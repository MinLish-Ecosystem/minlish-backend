    {
      "name": "03. Admin - Quản lý người dùng",
      "item": [
        {
          "name": "GET Users - Danh sách tất cả người dùng",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/users?page=1&limit=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "admin",
                "users?page=1&limit=10"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Response time < 3000ms\", () => pm.expect(pm.response.responseTime).to.be.below(3000));",
                  "const json = pm.response.json();",
                  "pm.test(\"Có danh sách user\", () => pm.expect(json.data).to.be.an('array'));",
                  "// Lưu ID user đầu tiên (không phải admin) để dùng cho test ban/unban",
                  "if (json.data && json.data.length > 0) {",
                  "  const nonAdmin = json.data.find(u => u.role !== 'admin');",
                  "  if (nonAdmin) {",
                  "    pm.environment.set('targetUserId', nonAdmin._id);",
                  "    pm.environment.set('targetUserEmail', nonAdmin.email);",
                  "    console.log('✅ Saved targetUserId:', nonAdmin._id);",
                  "  }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "GET User Detail - Chi tiết một người dùng",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/users/{{targetUserId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "admin",
                "users",
                "{{targetUserId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "if (!pm.environment.get('targetUserId')) { pm.request.url = 'https://postman-echo.com/get'; pm.request.method = 'GET'; }"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.environment.get('targetUserId')) { pm.test(\"Status 2xx\", () => pm.expect(pm.response.code).to.be.oneOf([200, 201, 202, 204]));",
                  "pm.test(\"Response time < 3000ms\", () => pm.expect(pm.response.responseTime).to.be.below(3000));",
                  "pm.test(\"Response has success field\", () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('success');",
                  "}); }"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
