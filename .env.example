# ============================================
# Minlish Backend - Environment Variables
# ============================================

# ===== SERVER =====
PORT=3001
NODE_ENV=development

# ===== MONGODB =====
# Local: dùng khi dev offline
MONGO_URI_LOCAL=mongodb://localhost:27017/minlish
# Atlas: dùng khi deploy hoặc kết nối cloud
MONGO_URI_ATLAS=${MONGO_URI_ATLAS}
# Biến môi trường chính được sử dụng trong code (thay đổi giá trị này tùy môi trường)
MONGO_URI=${MONGO_URI_ATLAS}

# ===== JWT =====
# Lưu ý: Nên thay đổi các secret key này bằng chuỗi random dài để bảo mật tốt hơn
JWT_ACCESS_SECRET=your_super_secret_access_key_here
JWT_REFRESH_SECRET=your_super_secret_refresh_key_here
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# ===== GMAIL SMTP =====
MAIL_USER=@{gmail}
MAIL_PASS=@{mail_pass}

# ===== CLOUDINARY =====
CLOUDINARY_CLOUD_NAME=@{CLOUDINARY_CLOUD_NAME}
CLOUDINARY_API_KEY=@{CLOUDINARY_API_KEY}
CLOUDINARY_API_SECRET=@{CLOUDINARY_API_SECRET}

# ===== REDIS (Upstash) =====
# Lưu ý: Đã sửa port từ 637 thành 6379 (chuẩn của Redis/Upstash)
REDIS_URL=@{REDIS_URL}

# ===== GEMINI API =====
GEMINI_API_KEY=@{GEMINI_API_KEY}

# ===== FRONTEND & CORS =====
FRONTEND_URL=http://localhost:5173,http://localhost:3000

# ===== VOICE AI (UC-13) =====
# Base URL build link tải weights (nối với megaFileId)
VOICE_AI_CDN_URL=https://cdn.example.com/models
# Fallback system prompt nếu SystemConfig.voiceAiSystemPrompt rỗng
# Ưu tiên cao nhất: SystemConfig (admin sửa) > env này > default trong code
VOICE_AI_SYSTEM_PROMPT=

# ===== ADMIN TOOLS =====
MONGO_EXPRESS_PORT=8081