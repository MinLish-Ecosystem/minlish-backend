# ============================================
# Minlish Backend - Environment Template
# Copy this file to .env and fill in your actual values
# ============================================

# ===== SERVER =====
PORT=3000
NODE_ENV=development

# ===== MONGODB =====
# Local: dùng khi dev offline
MONGO_URI_LOCAL=mongodb://localhost:27017/minlish
# Atlas: dùng khi deploy hoặc kết nối cloud (thay thế <username>, <password>, <cluster>)
MONGO_URI_ATLAS=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/minlish?appName=Cluster0
# Biến môi trường chính được sử dụng trong code
MONGO_URI=${MONGO_URI_LOCAL}

# ===== JWT =====
# Secret key cho Access Token (nên dùng chuỗi dài, random)
JWT_ACCESS_SECRET=your_super_secret_access_key_here
# Secret key cho Refresh Token (dùng chuỗi KHÁC với access)
JWT_REFRESH_SECRET=your_super_secret_refresh_key_here
# Thời gian sống của Access Token (15m, 30m, 1h...)
JWT_ACCESS_EXPIRES_IN=1h
# Thời gian sống của Refresh Token (7d, 30d...)
JWT_REFRESH_EXPIRES_IN=7d

# ===== GMAIL SMTP =====
# Email của bạn (địa chỉ gmail)
MAIL_USER=your_email@gmail.com
# App Password - KHÔNG phải mật khẩu gmail thật!
# Hướng dẫn tạo: Google Account > Security > 2-Step Verification > App Passwords
# Lưu ý: Xóa hết khoảng trắng do Google cung cấp khi dán vào đây
MAIL_PASS=your_gmail_app_password_here

# ===== CLOUDINARY =====
# Lấy thông tin tại: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ===== REDIS =====
# URL kết nối Redis (Local: redis://localhost:6379 hoặc Upstash/Cloud)
REDIS_URL=redis://localhost:6379

# ===== GEMINI API =====
# Lấy API Key tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ===== FRONTEND & CORS =====
# Danh sách các URL frontend được phép truy cập (cách nhau bởi dấu phẩy)
FRONTEND_URL=http://localhost:5173,http://localhost:3000

# ===== ADMIN TOOLS =====
MONGO_EXPRESS_PORT=8081